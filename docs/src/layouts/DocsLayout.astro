---
import type { MarkdownHeading } from 'astro';
import Sidebar from '../components/Sidebar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { withBase } from '../lib/base';
import { GITHUB_REPO, GITHUB_URL, getStarCount, formatStars } from '../lib/github';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  headings?: MarkdownHeading[];
}

const SITE_TITLE = 'Autotune';
const { title, description, headings = [] } = Astro.props;
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;

// Fetched once at build time (memoized); null if unavailable — see lib/github.ts.
const stars = await getStarCount();
const starLabel =
  stars !== null
    ? `Star ${GITHUB_REPO} on GitHub (${stars} star${stars === 1 ? '' : 's'})`
    : `Star ${GITHUB_REPO} on GitHub`;
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-mode="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {/* Resolve the theme before first paint to avoid a flash of the wrong colors. */}
    <script is:inline>
      (function () {
        try {
          var v = localStorage.getItem('theme');
          var mode = v === 'light' || v === 'dark' || v === 'auto' ? v : 'auto';
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var resolved = mode === 'auto' ? (prefersDark ? 'dark' : 'light') : mode;
          var root = document.documentElement;
          root.dataset.theme = resolved;
          root.dataset.themeMode = mode;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={withBase('/')}>
          <img src={withBase('/favicon.svg')} alt="" width="22" height="22" />
          <span>{SITE_TITLE}</span>
        </a>
        <div class="header-actions">
          <a
            class="gh-star"
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={starLabel}
            title={starLabel}
          >
            <svg
              class="gh-star-mark"
              viewBox="0 0 16 16"
              width="16"
              height="16"
              aria-hidden="true"
              fill="currentColor"
            >
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
              />
            </svg>
            <span class="gh-star-text">Star</span>
            {stars !== null && <span class="gh-star-count">{formatStars(stars)}</span>}
          </a>
          <ThemeToggle />
        </div>
      </div>
    </header>

    <div class="layout">
      <aside class="sidebar-col">
        <Sidebar />
      </aside>

      <main class="content">
        <article class="prose">
          <h1>{title}</h1>
          {description && <p class="lead">{description}</p>}
          <slot />
        </article>
        <footer class="content-footer">
          <p>Autotune documentation · built with Astro</p>
        </footer>
      </main>

      {
        toc.length > 0 && (
          <aside class="toc-col">
            <nav class="toc" aria-label="On this page">
              <p class="toc-title">On this page</p>
              <ul>
                {toc.map((h) => (
                  <li class:list={[`toc-depth-${h.depth}`]}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </body>
</html>
